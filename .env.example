# Kopieren nach .env und ausfüllen (wird NICHT eingecheckt). Laden z. B. mit:
#   set -a; source .env; set +a
# Paper-Modus braucht keine Schlüssel.

# Live-Modus: API-Key OHNE Auszahlungsrechte anlegen!
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Optional: LLM-Strategie-Recherche
ANTHROPIC_API_KEY=

# Optional: Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Solana-Bot-Wallet (nur broker: solana): privater Schlüssel einer EIGENEN Wallet nur für den Bot
# (Phantom: Konto-Menü -> Privaten Schlüssel exportieren; Base58-Text). NIE die Haupt-Wallet verwenden!
SOLANA_PRIVATE_KEY=
